# variáveis de ambiente ou em arquivos locais, nunca no repositório.
.env
.env.*
!.env.example
application-local.properties
application-local.yml
application-secret*.properties
*.pem
*.key
*.p12
*.jks

# ---------- Logs ----------
*.log
logs/
hs_err_pid*
replay_pid*

