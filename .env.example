# Frontend (usado nos links de e-mail e no redirecionamento do OAuth)
FRONTEND_URL=http://localhost:5173

# Mercado Pago (Suas integrações -> aplicação do AUcolher)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Tem de ser idêntica à cadastrada na aplicação, ex: https://api.exemplo.com/api/mercado-pago/oauth/callback
MP_REDIRECT_URI=
MP_WEBHOOK_SECRET=
# openssl rand -base64 32   (32 bytes em Base64)
MP_TOKEN_ENCRYPTION_KEY=
# true no sandbox (credenciais de teste)
MP_TEST_TOKEN=false
# Segredo que assina o "state" do OAuth. Use o mesmo segredo do JWT do projeto.
MP_STATE_SECRET=

# SMTP do Gmail (senha de app). Sem MAIL_USERNAME o link só aparece no log.
MAIL_USERNAME=
MAIL_PASSWORD=
